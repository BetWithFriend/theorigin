{%- comment -%} Lazy load subscription CSS (kept fully separate from questionnaire.css) {%- endcomment -%}
<link
  rel="preload"
  href="{{ 'subscription.css' | asset_url }}"
  as="style"
  onload="this.onload=null;this.rel='stylesheet'">
<noscript>{{ 'subscription.css' | asset_url | stylesheet_tag }}</noscript>
<script src="{{ 'subscription.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign subscription_product = section.settings.subscription_product
  if subscription_product == blank
    assign subscription_product = all_products['מנוי-קפה']
  endif

  assign sub_price_1kg_monthly = 17500
  assign sub_price_2kg_monthly = 35000
  assign sub_price_4kg_monthly = 68000

  if subscription_product != blank
    for variant in subscription_product.variants
      assign weight_token = variant.option1 | split: ' ' | first
      assign length_token = variant.option2 | split: ' ' | first
      if length_token == '3'
        assign monthly_cents = variant.price | divided_by: 3
        if weight_token == '1'
          assign sub_price_1kg_monthly = monthly_cents
        elsif weight_token == '2'
          assign sub_price_2kg_monthly = monthly_cents
        elsif weight_token == '4'
          assign sub_price_4kg_monthly = monthly_cents
        endif
      endif
    endfor
  endif
-%}

<div class="subscription-wrapper" id="subscriptionWrapper">
  <script>
    (function () {
      var el = document.getElementById('subscriptionWrapper');
      if (!el) return;
      var mainContent = document.getElementById('MainContent');
      document.body.classList.add('subscription-wrapper-open');
      if (mainContent) {
        mainContent.classList.add('subscription-wrapper-open');
      }
    })();
  </script>

  {%- comment -%} ── Intro / preview screen ─────────────────────────────── {%- endcomment -%}
  <div
    class="subscription-step subscription-intro active"
    id="subscriptionIntroStep"
    data-step-index="intro">
    <div class="subscription-intro-header">
      <div class="subscription-close-icon" onclick="closeSubscriptionForm()">
        {% render 'subscription-icon'
          , icon: 'close' %}
      </div>
    </div>
    <div class="subscription-intro-content">
      <div class="subscription-intro-image-wrapper">
        <img
          class="subscription-intro-image"
          src="{{ 'questionnaire_intro_beans.png' | asset_url }}"
          alt="פולי קפה בדרגות קלייה שונות"
          width="462"
          height="170"
          loading="eager">
      </div>
      <div class="subscription-intro-text">
        <h2 class="subscription-intro-title">
          {{ section.settings.intro_title | default: 'מנוי הקפה שלכם מתחיל כאן' }}
        </h2>
        <p class="subscription-intro-subtitle">
          {{
            section.settings.intro_subtitle | default: 'קפה ספשלטי טרי מבית קלייה משתנה, בכל חודש אצלכם בדלת.'
          }}
        </p>
        <div class="subscription-intro-desc">
          {{
            section.settings.intro_description | default: '<p>עונים על שאלון קצר: העדפות טעם, כמה קפה, מתי ועוד קצת – ומקבלים קפה מותאם אישית עד הבית, כל חודש.</p><p>אנחנו נבחר כמה סוגי קפה מושלמים כל חודש ונשלח ישר אליכם.<br>לכם נשאר רק להנות מקפה מעולה!</p>'
          }}
        </div>
      </div>
      <div class="subscription-intro-actions">
        <button
          type="button"
          class="subscription-intro-start-btn"
          onclick="startSubscriptionFromIntro()">
          {{ section.settings.intro_button_text | default: 'בואו נתחיל' }}
        </button>
        <div class="subscription-intro-social-proof">
          <div class="subscription-intro-stars" aria-hidden="true">
            {% for i in (1..5) %}
              <svg
                class="subscription-intro-star"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="currentColor"
                xmlns="http://www.w3.org/2000/svg">
                <path d="M12 2.5l2.69 5.45 6.02.88-4.35 4.24 1.03 5.99L12 16.7l-5.39 2.83 1.03-5.99-4.35-4.24 6.02-.88z" />
              </svg>
            {% endfor %}
          </div>
          <div class="subscription-intro-social-text">
            {{ section.settings.intro_social_text | default: 'מאות לקוחות מרוצים' }}
          </div>
        </div>
      </div>
    </div>
  </div>

