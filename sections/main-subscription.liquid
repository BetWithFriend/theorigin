{%- comment -%} Lazy load subscription CSS (kept fully separate from questionnaire.css) {%- endcomment -%}
<link
  rel="preload"
  href="{{ 'subscription.css' | asset_url }}"
  as="style"
  onload="this.onload=null;this.rel='stylesheet'">
<noscript>{{ 'subscription.css' | asset_url | stylesheet_tag }}</noscript>
<script src="{{ 'subscription.js' | asset_url }}" defer="defer"></script>

<div class="subscription-wrapper" id="subscriptionWrapper">
  <script>
    (function () {
      var el = document.getElementById('subscriptionWrapper');
      if (!el) return;
      var mainContent = document.getElementById('MainContent');
      document.body.classList.add('subscription-wrapper-open');
      if (mainContent) {
        mainContent.classList.add('subscription-wrapper-open');
      }
    })();
  </script>

  {%- comment -%} ── Step 1: Subscription level ─────────────────────────── {%- endcomment -%}
  <div class="subscription-step active" id="subscriptionStep1" data-step-index="1">
    <div class="subscription-progress-bar-wrapper">
      <div class="subscription-progress-bar filled"></div>
      <div class="subscription-progress-bar"></div>
      <div class="subscription-progress-bar"></div>
      <div class="subscription-progress-bar"></div>
    </div>
    <div class="subscription-title-wrapper">
      <div class="subscription-close-icon" onclick="closeSubscriptionForm()">
        {% render 'subscription-icon', icon: 'close' %}
      </div>
      <div class="subscription-title">{{ section.settings.step1_title | default: 'רמת המנוי' }}</div>
      <div class="subscription-back-icon-wrapper"></div>
    </div>
    <div class="subscription-options" data-field="tier">
      <button type="button" class="subscription-option subscription-option--tier" data-value="specialty">
        <span class="subscription-option-icon">{% render 'subscription-icon', icon: 'ribbon' %}</span>
        <span class="subscription-option-body">
          <span class="subscription-option-title">Origin Specialty:</span>
          <span class="subscription-option-desc">בחירה מעולה ליומיום. בלנדים וזנים איכותיים מבית קלייה מתחלף.</span>
          <span class="subscription-option-price">170 ₪ למארז (4 שקיות)</span>
        </span>
      </button>
      <button type="button" class="subscription-option subscription-option--tier" data-value="premium">
        <span class="subscription-option-icon">{% render 'subscription-icon', icon: 'crown' %}</span>
        <span class="subscription-option-body">
          <span class="subscription-option-title">Origin Premium:</span>
          <span class="subscription-option-desc">לאלו שמחפשים את היוצא מהכלל, פולים נדירים, עיבודים מיוחדים וציונים גבוהים במיוחד.</span>
          <span class="subscription-option-price">210 ₪ למארז (4 שקיות)</span>
        </span>
      </button>
    </div>
  </div>

  {%- comment -%} ── Step 2: Quantity & consumption ─────────────────────── {%- endcomment -%}
  <div class="subscription-step" id="subscriptionStep2" data-step-index="2">
    <div class="subscription-progress-bar-wrapper">
      <div class="subscription-progress-bar filled"></div>
      <div class="subscription-progress-bar filled"></div>
      <div class="subscription-progress-bar"></div>
      <div class="subscription-progress-bar"></div>
    </div>
    <div class="subscription-title-wrapper">
      <div class="subscription-close-icon" onclick="closeSubscriptionForm()">
        {% render 'subscription-icon', icon: 'close' %}
      </div>
      <div class="subscription-title">{{ section.settings.step2_title | default: 'כמות וצריכה' }}</div>
      <div class="subscription-back-icon-wrapper" onclick="goToPreviousSubscriptionStep()">
        <img
          class="subscription-back-icon"
          src="{{ 'questionnaire_back_icon.png' | asset_url }}"
          alt="חזרה"
          width="20"
          height="20">
      </div>
    </div>
    <div class="subscription-options" data-field="quantity">
      <button type="button" class="subscription-option subscription-option--qty" data-value="4">
        <span class="subscription-option-icon">{% render 'subscription-icon', icon: 'bag' %}</span>
        <span class="subscription-option-body">
          <span class="subscription-option-title">4 שקיות (1 ק"ג):</span>
          <span class="subscription-option-desc">כוס אחת ביום (מתאים ליחיד/זוג)</span>
          <span class="subscription-option-price">מחיר: 170 ₪</span>
        </span>
      </button>
      <button type="button" class="subscription-option subscription-option--qty" data-value="8">
        <span class="subscription-option-icon">{% render 'subscription-icon', icon: 'bag' %}</span>
        <span class="subscription-option-body">
          <span class="subscription-option-title">8 שקיות (2 ק"ג):</span>
          <span class="subscription-option-desc">2-3 כוסות ביום (מתאים למשפחה או משרד קטן)</span>
          <span class="subscription-option-badge">חסכת 20 ₪</span>
          <span class="subscription-option-price">מחיר: 320 ₪</span>
        </span>
      </button>
      <button type="button" class="subscription-option subscription-option--qty" data-value="16">
        <span class="subscription-option-icon">{% render 'subscription-icon', icon: 'bag' %}</span>
        <span class="subscription-option-body">
          <span class="subscription-option-title">16 שקיות (4 ק"ג):</span>
          <span class="subscription-option-desc">צריכה גבוהה (משרדים או חובבי קפה כבדים)</span>
          <span class="subscription-option-badge">חסכת 80 ₪ + משלוח חינם</span>
          <span class="subscription-option-price">מחיר: 600 ₪</span>
        </span>
      </button>
    </div>
  </div>

  {%- comment -%} ── Step 3: Preferred taste profile ────────────────────── {%- endcomment -%}
  <div class="subscription-step" id="subscriptionStep3" data-step-index="3">
    <div class="subscription-progress-bar-wrapper">
      <div class="subscription-progress-bar filled"></div>
      <div class="subscription-progress-bar filled"></div>
      <div class="subscription-progress-bar filled"></div>
      <div class="subscription-progress-bar"></div>
    </div>
    <div class="subscription-title-wrapper">
      <div class="subscription-close-icon" onclick="closeSubscriptionForm()">
        {% render 'subscription-icon', icon: 'close' %}
      </div>
      <div class="subscription-title">{{ section.settings.step3_title | default: 'פרופיל הטעם המועדף' }}</div>
      <div class="subscription-back-icon-wrapper" onclick="goToPreviousSubscriptionStep()">
        <img
          class="subscription-back-icon"
          src="{{ 'questionnaire_back_icon.png' | asset_url }}"
          alt="חזרה"
          width="20"
          height="20">
      </div>
    </div>
    <div class="subscription-options" data-field="profile">
      <button type="button" class="subscription-option subscription-option--profile" data-value="classic">
        <span class="subscription-option-icon">
          <img src="{{ 'questionnaire_Dark_2.png' | asset_url }}" alt="" class="subscription-option-img" width="32" height="32">
        </span>
        <span class="subscription-option-body">
          <span class="subscription-option-title">הקלאסי:</span>
          <span class="subscription-option-desc">עשיר ושוקולדי (קקאו, אגוזים, קרמל).</span>
        </span>
      </button>
      <button type="button" class="subscription-option subscription-option--profile" data-value="balanced">
        <span class="subscription-option-icon">
          <img src="{{ 'questionnaire_soft.png' | asset_url }}" alt="" class="subscription-option-img" width="32" height="32">
        </span>
        <span class="subscription-option-body">
          <span class="subscription-option-title">המאוזן:</span>
          <span class="subscription-option-desc">מתוק עם נגיעות פרי (שוקולד חלב, פירותיות מעודנת)</span>
        </span>
      </button>
      <button type="button" class="subscription-option subscription-option--profile" data-value="adventurous">
        <span class="subscription-option-icon">
          <img src="{{ 'questionnaire_special.png' | asset_url }}" alt="" class="subscription-option-img" width="32" height="32">
        </span>
        <span class="subscription-option-body">
          <span class="subscription-option-title">הרפתקני:</span>
          <span class="subscription-option-desc">פירותי ופרחוני (קליל, חמצמץ, "הגל השלישי")</span>
        </span>
      </button>
    </div>
  </div>

  {%- comment -%} ── Step 4: Preparation method (grind) ─────────────────── {%- endcomment -%}
  <div class="subscription-step" id="subscriptionStep4" data-step-index="4">
    <div class="subscription-progress-bar-wrapper">
      <div class="subscription-progress-bar filled"></div>
      <div class="subscription-progress-bar filled"></div>
      <div class="subscription-progress-bar filled"></div>
      <div class="subscription-progress-bar filled"></div>
    </div>
    <div class="subscription-title-wrapper">
      <div class="subscription-close-icon" onclick="closeSubscriptionForm()">
        {% render 'subscription-icon', icon: 'close' %}
      </div>
      <div class="subscription-title">{{ section.settings.step4_title | default: 'שיטת ההכנה (הטחינה)' }}</div>
      <div class="subscription-back-icon-wrapper" onclick="goToPreviousSubscriptionStep()">
        <img
          class="subscription-back-icon"
          src="{{ 'questionnaire_back_icon.png' | asset_url }}"
          alt="חזרה"
          width="20"
          height="20">
      </div>
    </div>
    <div class="subscription-options" data-field="grind">
      <button type="button" class="subscription-option subscription-option--grind" data-value="whole">
        <span class="subscription-option-icon">
          <img src="{{ 'questionnaire_intro_beans.png' | asset_url }}" alt="" class="subscription-option-img" width="32" height="32">
        </span>
        <span class="subscription-option-body">
          <span class="subscription-option-title">פולים שלמים:</span>
          <span class="subscription-option-desc">יש לי מטחנה בבית</span>
        </span>
      </button>
      <button type="button" class="subscription-option subscription-option--grind" data-value="espresso">
        <span class="subscription-option-icon">
          <img src="{{ 'questionnaire_Espresso_Machine.png' | asset_url }}" alt="" class="subscription-option-img" width="32" height="32">
        </span>
        <span class="subscription-option-body">
          <span class="subscription-option-title">אספרסו:</span>
          <span class="subscription-option-desc">טחינה דקה למכונה ביתית</span>
        </span>
      </button>
      <button type="button" class="subscription-option subscription-option--grind" data-value="moka">
        <span class="subscription-option-icon">
          <img src="{{ 'questionnaire_Moka_Pot.png' | asset_url }}" alt="" class="subscription-option-img" width="32" height="32">
        </span>
        <span class="subscription-option-body">
          <span class="subscription-option-title">מקינטה / קפה שחור:</span>
          <span class="subscription-option-desc">טחינה דקה-בינונית</span>
        </span>
      </button>
      <button type="button" class="subscription-option subscription-option--grind" data-value="v60">
        <span class="subscription-option-icon">
          <img src="{{ 'questionnaire_v60.png' | asset_url }}" alt="" class="subscription-option-img" width="32" height="32">
        </span>
        <span class="subscription-option-body">
          <span class="subscription-option-title">V60 / פילטר:</span>
          <span class="subscription-option-desc">טחינה בינונית</span>
        </span>
      </button>
      <button type="button" class="subscription-option subscription-option--grind" data-value="frenchpress">
        <span class="subscription-option-icon">
          <img src="{{ 'questionnaire_Aeropress.png' | asset_url }}" alt="" class="subscription-option-img" width="32" height="32">
        </span>
        <span class="subscription-option-body">
          <span class="subscription-option-title">Cold Brew / פרנץ' פרס:</span>
          <span class="subscription-option-desc">טחינה גסה</span>
        </span>
      </button>
    </div>
  </div>

  {%- comment -%} ── Results ─────────────────────────────────────────────── {%- endcomment -%}
  <div class="subscription-step subscription-results" id="subscriptionResultsStep" data-step-index="results">
    <header class="subscription-results-header">
      <a
        href="{{ routes.root_url }}"
        class="subscription-results-logo-link"
        aria-label="{{ shop.name }}"
        onclick="clearSubscriptionResultsState()">
        <img
          src="{{ 'logo.png' | asset_url }}"
          alt="{{ shop.name }}"
          class="subscription-results-logo"
          width="120"
          height="26">
      </a>
      <button
        type="button"
        class="subscription-results-reload-btn"
        onclick="restartSubscriptionFlow()"
        aria-label="התחל מחדש"
        title="התחל מחדש">
        {% render 'subscription-icon', icon: 'reload' %}
      </button>
    </header>

    <div class="subscription-results-icon">{% render 'subscription-icon', icon: 'calendar' %}</div>
    <h1 class="subscription-results-title">{{ section.settings.results_title | default: 'המנוי האישי שלך מוכן!' }}</h1>
    <p class="subscription-results-subtitle">
      {{
        section.settings.results_subtitle
        | default: 'התאמנו לך את חוויית הקפה המדויקת ביותר עבורך. בכל חודש נחכה לך סיפור חדש במעטפה.'
      }}
    </p>

    <div class="subscription-summary-card">
      <button
        type="button"
        class="subscription-summary-edit-btn"
        onclick="openSubscriptionEditSheet()"
        aria-label="{{ section.settings.edit_sheet_title | default: 'עריכת העדפות' }}">
        {% render 'subscription-icon', icon: 'pencil' %}
      </button>
      <div class="subscription-summary-title">{{ section.settings.summary_title | default: 'סיכום בחירות' }}</div>
      <div class="subscription-summary-rows" id="subscriptionSummaryRows"></div>
    </div>

    <div class="subscription-vendor-blurb" id="subscriptionVendorBlurb"></div>

    <div class="subscription-price-row">
      <span class="subscription-price-original" id="subscriptionPriceOriginal"></span>
      <span class="subscription-price-discounted" id="subscriptionPriceDiscounted"></span>
      <span class="subscription-price-caption">{{ section.settings.price_caption | default: 'כולל משלוח' }}</span>
    </div>

    <button type="button" class="subscription-cta-btn" id="subscriptionCtaBtn" onclick="submitSubscriptionToCart()">
      <span id="subscriptionCtaLabel">{{ section.settings.cta_text | default: 'הצטרפות למנוי' }}</span>
    </button>

    <div class="subscription-payment-row">
      <img class="subscription-payment-icon" src="{{ 'payment-visa.webp' | asset_url }}" alt="Visa" width="32" height="18">
      <img
        class="subscription-payment-icon"
        src="{{ 'payment-mastercard.webp' | asset_url }}"
        alt="MasterCard"
        width="32"
        height="18">
      <img
        class="subscription-payment-icon"
        src="{{ 'payment-google-pay.webp' | asset_url }}"
        alt="Google Pay"
        width="32"
        height="18">
      <img
        class="subscription-payment-icon"
        src="{{ 'payment-apple-pay.webp' | asset_url }}"
        alt="Apple Pay"
        width="32"
        height="18">
    </div>
    <div class="subscription-secure-note">
      <img class="subscription-secure-icon" src="{{ 'secure_buy.png' | asset_url }}" alt="" width="16" height="16">
      <span>רכישה מאובטחת</span>
    </div>
  </div>

  {%- comment -%} ── Edit preferences bottom sheet ───────────────────────── {%- endcomment -%}
  <div class="subscription-sheet-overlay" id="subscriptionEditSheetOverlay" onclick="closeSubscriptionEditSheet(event)">
    <div
      class="subscription-sheet"
      id="subscriptionEditSheet"
      role="dialog"
      aria-modal="true"
      aria-labelledby="subscriptionEditSheetTitle"
      onclick="event.stopPropagation()">
      <div class="subscription-sheet-header">
        <button
          type="button"
          class="subscription-sheet-close"
          onclick="closeSubscriptionEditSheet()"
          aria-label="סגירה">
          {% render 'subscription-icon', icon: 'close' %}
        </button>
        <div class="subscription-sheet-title" id="subscriptionEditSheetTitle">
          {{ section.settings.edit_sheet_title | default: 'עריכת העדפות' }}
        </div>
      </div>

      <div class="subscription-sheet-row">
        <span class="subscription-sheet-label">רמת המנוי</span>
        <span class="subscription-sheet-select-wrapper">
          <select class="subscription-sheet-select" id="subscriptionEditTier" data-field="tier">
            <option value="specialty">Origin Specialty</option>
            <option value="premium">Origin Premium</option>
          </select>
          <span class="subscription-sheet-chevron">{% render 'subscription-icon', icon: 'chevron' %}</span>
        </span>
      </div>

      <div class="subscription-sheet-row">
        <span class="subscription-sheet-label">כמות שקיות</span>
        <span class="subscription-sheet-select-wrapper">
          <select class="subscription-sheet-select" id="subscriptionEditQuantity" data-field="quantity">
            <option value="4">4 שקיות (1 ק"ג)</option>
            <option value="8">8 שקיות (2 ק"ג)</option>
            <option value="16">16 שקיות (4 ק"ג)</option>
          </select>
          <span class="subscription-sheet-chevron">{% render 'subscription-icon', icon: 'chevron' %}</span>
        </span>
      </div>

      <div class="subscription-sheet-row">
        <span class="subscription-sheet-label">הפרופיל</span>
        <span class="subscription-sheet-select-wrapper">
          <select class="subscription-sheet-select" id="subscriptionEditProfile" data-field="profile">
            <option value="classic">הקלאסי</option>
            <option value="balanced">המאוזן</option>
            <option value="adventurous">הרפתקני</option>
          </select>
          <span class="subscription-sheet-chevron">{% render 'subscription-icon', icon: 'chevron' %}</span>
        </span>
      </div>

      <div class="subscription-sheet-row">
        <span class="subscription-sheet-label">הטחינה</span>
        <span class="subscription-sheet-select-wrapper">
          <select class="subscription-sheet-select" id="subscriptionEditGrind" data-field="grind">
            <option value="whole">פולים שלמים</option>
            <option value="espresso">אספרסו - טחינה דקה</option>
            <option value="moka">מקינטה / קפה שחור - טחינה דקה-בינונית</option>
            <option value="v60">V60 / פילטר - טחינה בינונית</option>
            <option value="frenchpress">Cold Brew / פרנץ' פרס - טחינה גסה</option>
          </select>
          <span class="subscription-sheet-chevron">{% render 'subscription-icon', icon: 'chevron' %}</span>
        </span>
      </div>

      <button type="button" class="subscription-sheet-update-btn" onclick="applySubscriptionEditSheet()">
        {{ section.settings.edit_sheet_update_text | default: 'עדכן' }}
      </button>
    </div>
  </div>

  {%- comment -%}
    Lightweight product catalog for the simulated vendor/roastery recommendation.
    PLACEHOLDER: mirrors the field shape used by main-questionnaire's QuestionnaireScoring,
    trimmed down to only what SubscriptionScoring needs. Replace with the real bundle/
    subscription recommendation service once it is ready.
  {%- endcomment -%}
  {% paginate collections.all.products by 250 %}
    <script type="application/json" id="subscription-products-data">
      [
        {%- assign s_product_first = true -%}
        {%- for product in collections.all.products -%}
          {%- unless product.tags contains 'bundle'
            or product.tags contains 'decaf'
            or product.tags contains 'Decaf'
            or product.metafields.custom.coffee_process == 'נטול קפאין'
            or product.metafields.custom.coffee_process == 'decaf'
            or product.metafields.custom.coffee_process == 'Decaf'
          -%}
            {%- unless s_product_first -%},{%- endunless -%}
            {%- assign s_product_first = false -%}
            {
              "id": {{ product.id }},
              "title": {{ product.title | json }},
              "vendor": {{ product.vendor | json }},
              "vendor_short_name": {{ product.metafields.vendor_info.coffee_vendor.value.vendor_short_name | json }},
              "variantId": {{ product.selected_or_first_available_variant.id }},
              "available": {{ product.selected_or_first_available_variant.available }},
              "metafields": {
                "coffee_prep_methods": {{ product.metafields.custom.coffee_prep_methods | default: '[]' }},
                "coffee_tastes": {{ product.metafields.custom.coffee_tastes | default: '[]' }}
              }
            }
          {%- endunless -%}
        {%- endfor -%}
      ]
    </script>
  {% endpaginate %}

  <script>
    window.subscriptionSettings = {
      closeRedirect: {{ section.settings.close_redirect | default: '/' | json }},
      pricing: {
        specialty: {
          4: {{ section.settings.specialty_price_4 | default: 170 }},
          8: {{ section.settings.specialty_price_8 | default: 320 }},
          16: {{ section.settings.specialty_price_16 | default: 600 }}
        },
        premium: {
          4: {{ section.settings.premium_price_4 | default: 210 }},
          8: {{ section.settings.premium_price_8 | default: 395 }},
          16: {{ section.settings.premium_price_16 | default: 740 }}
        }
      },
      promoDiscountPercent: {{ section.settings.promo_discount_percent | default: 20 }}
    };
  </script>
</div>

{% schema %}
{
  "name": "Main Subscription",
  "tag": "section",
  "class": "main-subscription-section",
  "settings": [
    {
      "type": "header",
      "content": "כותרות שלבי המנוי"
    },
    {
      "type": "text",
      "id": "step1_title",
      "label": "כותרת שלב 1 - רמת מנוי",
      "default": "רמת המנוי"
    },
    {
      "type": "text",
      "id": "step2_title",
      "label": "כותרת שלב 2 - כמות וצריכה",
      "default": "כמות וצריכה"
    },
    {
      "type": "text",
      "id": "step3_title",
      "label": "כותרת שלב 3 - פרופיל טעם",
      "default": "פרופיל הטעם המועדף"
    },
    {
      "type": "text",
      "id": "step4_title",
      "label": "כותרת שלב 4 - שיטת הכנה",
      "default": "שיטת ההכנה (הטחינה)"
    },
    {
      "type": "header",
      "content": "מסך תוצאה"
    },
    {
      "type": "text",
      "id": "results_title",
      "label": "כותרת מסך תוצאה",
      "default": "המנוי האישי שלך מוכן!"
    },
    {
      "type": "textarea",
      "id": "results_subtitle",
      "label": "תת-כותרת מסך תוצאה",
      "default": "התאמנו לך את חוויית הקפה המדויקת ביותר עבורך. בכל חודש נחכה לך סיפור חדש במעטפה."
    },
    {
      "type": "text",
      "id": "summary_title",
      "label": "כותרת כרטיס סיכום",
      "default": "סיכום בחירות"
