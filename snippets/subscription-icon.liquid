{%- comment -%}
  Renders an inline SVG icon for the subscription flow.
  Usage: {% render 'subscription-icon', icon: 'close' %}
  Placeholder icon set — swap for exact Figma-exported icons when available.
{%- endcomment -%}
{%- case icon -%}
  {%- when 'close' -%}
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
      <line x1="6" y1="6" x2="18" y2="18" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
      <line x1="18" y1="6" x2="6" y2="18" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
    </svg>
  {%- when 'ribbon' -%}
    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
      <circle cx="12" cy="9" r="6" stroke="currentColor" stroke-width="1.6" />
      <path d="M9 14.2L7.2 21l4.8-2.6 4.8 2.6-1.8-6.8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
      <path d="M9.5 9.3l1.7 1.7 3.3-3.4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  {%- when 'crown' -%}
    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
      <path d="M4 18h16l-1.4-8.4-4.1 3.4L12 6l-2.5 7-4.1-3.4L4 18z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" />
      <line x1="5" y1="20.5" x2="19" y2="20.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
    </svg>
  {%- when 'bag' -%}
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
      <path d="M7 9V7a5 5 0 0 1 10 0v2" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
      <rect x="4.5" y="9" width="15" height="12" rx="2.5" stroke="currentColor" stroke-width="1.6" />
      <circle cx="12" cy="14" r="1.5" fill="currentColor" />
    </svg>
  {%- when 'calendar' -%}
    <svg width="32" height="32" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
      <rect x="3.5" y="5" width="17" height="15" rx="2.5" stroke="currentColor" stroke-width="1.6" />
      <line x1="3.5" y1="9.5" x2="20.5" y2="9.5" stroke="currentColor" stroke-width="1.6" />
      <line x1="8" y1="3" x2="8" y2="6.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
      <line x1="16" y1="3" x2="16" y2="6.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
      <text x="12" y="16.3" font-size="7" font-family="Assistant, sans-serif" font-weight="700" text-anchor="middle" fill="currentColor">17</text>
    </svg>
  {%- when 'pencil' -%}
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
      <path d="M4 20l.9-4L16.6 4.3a1.5 1.5 0 0 1 2.1 0l1 1a1.5 1.5 0 0 1 0 2.1L8 19.1 4 20z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" />
      <line x1="14.5" y1="6.4" x2="17.6" y2="9.5" stroke="currentColor" stroke-width="1.5" />
    </svg>
  {%- when 'chevron' -%}
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
      <path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  {%- when 'reload' -%}
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
      <path d="M21 12a9 9 0 1 1-9-9c2.52 0 4.93 1 6.74 2.74L21 8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
      <path d="M21 3v5h-5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
{%- endcase -%}
