{%- comment -%}
  Calculates quantity bundle discount for a single vendor.
  4+ items from the same vendor → 5%; 8+ items → 8%.
  Uses original_line_price so the amount stays correct when Shopify
  has already applied the automatic bundle discount to line_price.
  Outputs pipe-separated:
  discount_cents|discount_percent|vendor_subtotal_cents|vendor_qty|shopify_applied
{%- endcomment -%}
{%- liquid
  assign vendor_key = vendor | default: ''
  assign vendor_qty = 0
  assign vendor_subtotal = 0
  assign vendor_discount_percent = 0
  assign vendor_discount_cents = 0
  assign vendor_shopify_applied = 0

  for item in cart.items
    if item.vendor == vendor_key
      assign vendor_qty = vendor_qty | plus: item.quantity
      assign vendor_subtotal = vendor_subtotal | plus: item.original_line_price
      if item.original_line_price != item.final_line_price
        assign vendor_shopify_applied = 1
      endif
    endif
  endfor

  if vendor_qty >= 8
    assign vendor_discount_percent = 8
  elsif vendor_qty >= 4
    assign vendor_discount_percent = 5
  endif
  if vendor_discount_percent > 0 and vendor_subtotal > 0
    for item in cart.items
      if item.vendor == vendor_key
        if item.original_line_price != item.final_line_price
          assign line_discount = item.original_line_price | minus: item.final_line_price
        else
          assign line_discount = item.original_line_price | times: vendor_discount_percent | plus: 50 | divided_by: 100
        endif
        assign vendor_discount_cents = vendor_discount_cents | plus: line_discount
      endif
    endfor
  endif
-%}
{{- vendor_discount_cents -}}|{{- vendor_discount_percent -}}|{{- vendor_subtotal -}}|{{- vendor_qty -}}|{{- vendor_shopify_applied -}}
